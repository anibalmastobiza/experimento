\pard\qc\sl480\slmult1\f0\fs24\b Who Does My Child Believe: Me or AI?\b0\par
\pard\qc\sl480\slmult1\f0\fs24\b A Home-Based Event-Boundary Paradigm for Epistemic Deference in Early Childhood\b0\par
\pard\ql\sl480\slmult1\f0\fs24\par
\pard\ql\sl480\slmult1\f0\fs24 Anibal M. Astobiza  \par
\pard\ql\sl480\slmult1\f0\fs24 University of Granada\par
\pard\ql\sl480\slmult1\f0\fs24\par
\pard\ql\sl480\slmult1\f0\fs24 Author Note  \par
\pard\ql\sl480\slmult1\f0\fs24 Anibal M. Astobiza, Department of Philosophy I, University of Granada.  \par
